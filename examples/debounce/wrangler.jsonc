{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-utils-example-debounce",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [{ "name": "DEBOUNCE", "class_name": "ExampleDebounceAndLease" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ExampleDebounceAndLease"] }]
}
