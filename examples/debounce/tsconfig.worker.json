{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "composite": true
  },
  "include": [
    "src/worker.ts",
    "src/do.ts",
    "src/shared.ts",
    "worker-configuration.d.ts",
    "vite.config.ts"
  ]
}
