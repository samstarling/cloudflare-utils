{
  "name": "@samstarling/cloudflare-utils-debounce",
  "version": "0.0.0",
  "description": "Debounce a burst of signals into one globally-exclusive, crash-recoverable action per key, on Cloudflare Durable Objects alone.",
  "type": "module",
  "license": "MIT",
  "author": "Sam Starling",
  "private": false,
  "sideEffects": false,
  "keywords": [
    "cloudflare",
    "cloudflare-workers",
    "durable-objects",
    "debounce",
    "lease",
    "distributed-lock",
    "concurrency"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samstarling/cloudflare-utils.git",
    "directory": "packages/debounce"
  },
  "homepage": "https://github.com/samstarling/cloudflare-utils/tree/main/packages/debounce#readme",
  "bugs": {
    "url": "https://github.com/samstarling/cloudflare-utils/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "cf-typegen": "wrangler types --config test/wrangler.jsonc --path test/worker-configuration.d.ts",
    "build": "tsup && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
